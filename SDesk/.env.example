# SMTP generico
# Exemplos:
# Outlook/Microsoft 365 -> MAIL_SERVER=smtp.office365.com / MAIL_PORT=587 / MAIL_USE_TLS=true
# Zoho -> MAIL_SERVER=smtp.zoho.com / MAIL_PORT=587 / MAIL_USE_TLS=true
# Hostinger -> use o SMTP informado pelo provedor
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=seu-email@provedor.com
MAIL_PASSWORD=sua-senha-ou-token
MAIL_DEFAULT_SENDER=seu-email@provedor.com
MAIL_TIMEOUT=20
